# 事業者からのお問い合わせ・お申込みを受けるメールアドレス（コピーして .env.local にして使う。.env.local はGitに入れない）
VITE_CONTACT_EMAIL=

# Google アナリティクス（GA4）の測定ID。Vercelの環境変数（Production）に登録する。空なら、計測しない
VITE_GA_MEASUREMENT_ID=

# お問い合わせフォームを公開する（1）。Resendの設定（RESEND_API_KEY・CONTACT_TO・CONTACT_FROM）が済んでから。docs/design/contact-form-plan.md
VITE_CONTACT_FORM=
